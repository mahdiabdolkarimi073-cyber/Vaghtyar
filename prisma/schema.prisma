generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SmsRecipientType {
  CUSTOMER
  BUSINESS
}

enum SmsType {
  APPOINTMENT_CONFIRM
  APPOINTMENT_REMINDER
  NEW_BOOKING_NOTIFY
  APPOINTMENT_CANCEL
}

enum SmsLogStatus {
  PENDING
  SENT
  FAILED
  SIMULATED
}

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  businesses   Business[]
  bookings     Booking[]  @relation("CustomerBookings")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  name                  String
  category              String
  categoryId            String?
  city                  String          @default("کرمان")
  neighborhood          String?
  address               String?
  phone                 String?
  email                 String?
  coverImage            String?
  profileImage          String?
  photos                String[]
  description           String?
  isVerified            Boolean         @default(false)
  isFeatured            Boolean         @default(false)
  autoConfirm           Boolean         @default(false)
  autoApprove           Boolean         @default(false)
  minAdvanceBookingHours Int           @default(2)
  minAdvanceHours       Int             @default(1)
  maxAdvanceDays        Int             @default(30)
  allowCustomerCancel   Boolean         @default(true)
  reminderHoursBefore   Int             @default(24)
  confirmationSmsTemplate String?
  reminderSmsTemplate   String?
  status                BusinessStatus  @default(PENDING)
  passwordHash          String?
  ownerFirstName        String?
  ownerLastName         String?
  ownerMobile           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  ownerId               String
  owner                 User            @relation(fields: [ownerId], references: [id])
  hours                BusinessHours[]
  staff                Staff[]
  services             Service[]
  bookings             Booking[]
  reviews              Review[]
  workingHours          WorkingHours[]
  holidays              Holiday[]
  customers             Customer[]
  subscription          Subscription?
  payments              Payment[]
  appointments          Appointment[]
  advertisements        Advertisement[]
  smsLogs               SmsLog[]
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model WorkingHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  isClosed   Boolean  @default(false)
  startTime  String?
  endTime    String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Holiday {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime
  reason     String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Staff {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  photo        String?
  specialty    String?
  bio          String?
  isActive     Boolean  @default(true)
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  workingHours  StaffWorkingHours[]
  bookings      Booking[]
  appointments  Appointment[]

  @@index([businessId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([staffId, serviceId])
}

model StaffWorkingHours {
  id        String   @id @default(cuid())
  staffId   String
  dayOfWeek Int
  isClosed  Boolean  @default(false)
  startTime String?
  endTime   String?
  useBusinessDefault Boolean @default(true)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  durationMinutes Int
  price           Int
  description     String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  staffServices   StaffService[]
  appointments    Appointment[]

  @@index([businessId])
}

model Booking {
  id              String        @id @default(cuid())
  businessId      String
  serviceId       String
  staffId         String?
  customerId      String?
  customerName    String
  customerPhone   String
  customerNote    String?
  date            DateTime
  startTime       String
  endTime         String
  status          BookingStatus @default(PENDING)
  confirmationCode String      @unique
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  staff           Staff?        @relation(fields: [staffId], references: [id])
  customer        User?         @relation("CustomerBookings", fields: [customerId], references: [id])
  review          Review?

  @@index([businessId])
  @@index([staffId])
  @@index([customerId])
  // جلوگیری از رزرو مضاعف — یک کارمند در یک تاریخ و زمان شروع فقط یک نوبت
  @@unique([staffId, date, startTime])
}

model Appointment {
  id           String            @id @default(cuid())
  businessId   String
  customerId   String
  serviceId    String
  staffId      String
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(PENDING)
  source       AppointmentSource @default(ONLINE)
  internalNote String?
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service          @relation(fields: [serviceId], references: [id])
  staff        Staff            @relation(fields: [staffId], references: [id])

  @@index([businessId])
  @@index([customerId])
  @@index([staffId])
  // جلوگیری از رزرو مضاعف — یک کارمند نمی‌تواند دو نوبت در یک زمان شروع داشته باشد
  @@unique([staffId, startTime])
}

model Customer {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  mobile       String
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  notes        CustomerNote[]
  appointments Appointment[]
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  content    String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Review {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String   @unique
  customerName  String
  rating        Int
  comment       String?
  businessReply String?
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  icon  String?
  image String?
}

model City {
  id   String @id @default(cuid())
  name String
  slug String @unique
}

model SmsLog {
  id             String          @id @default(cuid())
  businessId      String
  appointmentId  String?
  recipientPhone  String
  recipientType   SmsRecipientType @default(CUSTOMER)
  smsType         SmsType
  messageBody     String
  status          SmsLogStatus    @default(SIMULATED)
  sentAt         DateTime?
  createdAt       DateTime        @default(now())
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([smsType])
  @@index([status])
}

model Plan {
  id                  String   @id @default(cuid())
  name                String
  price               Int
  maxServices         Int?
  maxStaff            Int?
  hasManualConfirm    Boolean  @default(false)
  smsConfirmQuota     Int?
  hasSmsReminder      Boolean  @default(false)
  hasRevenueReport    Boolean  @default(false)
  hasMarketplacePage  Boolean  @default(false)
  hasFeaturedListing  Boolean  @default(false)
  hasCustomerReviews  Boolean  @default(false)
  hasDiscountCodes    Boolean  @default(false)
  hasCustomerNotes    Boolean  @default(false)
  hasPhoneSupport     Boolean  @default(false)
  isActive            Boolean  @default(true)
  subscriptions       Subscription[]
  payments            Payment[]
}

model Subscription {
  id         String   @id @default(cuid())
  businessId String   @unique
  planId     String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(true)
  paymentId  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  plan       Plan     @relation(fields: [planId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  businessId     String
  planId         String
  amount         Int
  status         PaymentStatus @default(PENDING)
  transactionId String?
  authority      String?
  refId          String?
  paymentMethod  String        @default("zarinpal")
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id])
  plan           Plan          @relation(fields: [planId], references: [id])

  @@index([businessId])
}

enum AdType {
  FEATURED
  BANNER
}



enum NotificationType {
  BUSINESS_REGISTERED
  PAYMENT_RECEIVED
  SUBSCRIPTION_EXPIRING
  REVIEW_REPORTED
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Advertisement {
  id         String   @id @default(cuid())
  businessId String
  type       AdType
  image      String?
  startDate  DateTime
  endDate    DateTime
  price      Float
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}
