generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  businesses   Business[]
  bookings     Booking[]  @relation("CustomerBookings")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  category            String
  city                String
  neighborhood        String?
  address             String?
  phone               String?
  coverImage          String?
  profileImage        String?
  description         String?
  isVerified          Boolean         @default(false)
  isFeatured          Boolean         @default(false)
  autoConfirm         Boolean         @default(false)
  minAdvanceBookingHours Int          @default(2)
  createdAt           DateTime        @default(now())
  ownerId             String
  owner               User            @relation(fields: [ownerId], references: [id])
  hours               BusinessHours[]
  staff               Staff[]
  services            Service[]
  bookings            Booking[]
  reviews             Review[]
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Staff {
  id         String   @id @default(cuid())
  businessId String
  name       String
  photo      String?
  specialty  String?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]

  @@index([businessId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  durationMinutes Int
  price           Int
  description     String?
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([businessId])
}

model Booking {
  id              String        @id @default(cuid())
  businessId      String
  serviceId       String
  staffId         String?
  customerId      String?
  customerName    String
  customerPhone   String
  customerNote   String?
  date            DateTime
  startTime       String
  endTime         String
  status          BookingStatus @default(PENDING)
  confirmationCode String      @unique
  createdAt       DateTime      @default(now())
  business       Business      @relation(fields: [businessId], references: [id])
  service        Service       @relation(fields: [serviceId], references: [id])
  staff          Staff?        @relation(fields: [staffId], references: [id])
  customer       User?         @relation("CustomerBookings", fields: [customerId], references: [id])
  review         Review?

  @@index([businessId])
  @@index([staffId])
  @@index([customerId])
}

model Review {
  id            String   @id @default(cuid())
  businessId    String
  bookingId     String   @unique
  customerName  String
  rating        Int
  comment       String?
  businessReply String?
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  icon  String?
  image String?
}

model City {
  id   String @id @default(cuid())
  name String
  slug String @unique
}

model SmsLog {
  id      String   @id @default(cuid())
  phone   String
  message String
  sentAt  DateTime @default(now())
}
